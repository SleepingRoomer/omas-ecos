{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omas-ecos",
  "main": "src/index.js",
  "compatibility_date": "2026-01-02",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "keep_vars": true,
  "triggers": { "crons": ["0 16 * * *", "30 * * * *"] },
  // Sauvegarde hebdomadaire (src/backup.js) : créer d'abord le bucket R2 « omas-ecos-sauvegardes » dans Cloudflare
  // (Storage & databases, R2), puis enlever les deux barres devant la ligne ci-dessous. Sans bucket, le déploiement échouerait.
  // "r2_buckets": [{ "binding": "BACKUP", "bucket_name": "omas-ecos-sauvegardes" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "omas-ecos",
      "database_id": "f2bcd0e2-5690-4cf5-8b78-15a1b98b6797",
      "migrations_dir": "migrations"
    }
  ]
}
