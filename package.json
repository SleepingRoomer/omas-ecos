{
  "name": "omas-ecos",
  "version": "1.0.0",
  "description": "INES par OMAS Externat, plateforme des ECOS blancs : rédaction des stations, saisie des grilles, résultats en direct",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply omas-ecos --local",
    "db:migrate:prod": "wrangler d1 migrations apply omas-ecos --remote",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "wrangler": "^4.157.0"
  },
  "private": true,
  "type": "module"
}
